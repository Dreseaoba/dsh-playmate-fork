{
  "name": "dsh-playmate",
  "version": "0.1.1",
  "description": "给 DeepSeek Harness 用的陪玩插件：看屏幕（含自动发现变化）/ 热键语音输入 / 把回答念出来。不附带任何声音模型。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*": "./locale/*",
    "./icon": "./icon.svg",
    "./icon.png": "./icon.png"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "icon.png",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "companion",
    "screen",
    "speech-to-text",
    "tts",
    "playmate"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZiFeng11/dsh-playmate.git"
  },
  "homepage": "https://github.com/ZiFeng11/dsh-playmate#readme",
  "bugs": {
    "url": "https://github.com/ZiFeng11/dsh-playmate/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
